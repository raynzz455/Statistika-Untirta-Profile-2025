// Prisma schema for Statistika '25 website
//
// Database provider: PostgreSQL (Supabase production)
//
// Setup status: PRODUCTION-READY
// This schema is configured for Supabase PostgreSQL.
// For local dev without Supabase, see SETUP_RUNBOOK.md "Local SQLite mode".
//
// IMPORTANT: All models use @@map() for snake_case TABLE names AND
// @map() for snake_case COLUMN names. This ensures Prisma's DB schema
// matches the SQL files in supabase/ folder (rls-policies.sql,
// storage-policies.sql) which use snake_case for both tables and columns.
//
// Configuration:
//   - provider = "postgresql" — uses Supabase PostgreSQL pooler (port 6543)
//   - url = DATABASE_URL — pooler URL (Supavisor, transaction mode)
//   - directUrl = DIRECT_URL — direct URL (port 5432, for migrations)
//
// To run setup:
//   1. Fill .env with Supabase credentials (see SETUP_RUNBOOK.md)
//   2. Run: bash scripts/setup.sh
//   3. Run SQL files in Supabase SQL Editor (auto-printed by setup.sh)
//
// For local dev (SQLite, no Supabase):
//   1. Comment the postgresql config below, uncomment the sqlite block
//   2. Set DATABASE_URL="file:./db/custom.db" in .env
//   3. Run: bun run db:push && bun run db:seed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // === PRODUCTION (Supabase PostgreSQL) ===
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")

  // === LOCAL DEV (SQLite, uncomment to use) ===
  // provider = "sqlite"
  // url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("user") // "admin" | "user"
  displayName  String?  @map("display_name")
  theme        String   @default("light") // "light" | "dark"
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  articles     Article[]
  events       Event[]
  galleryItems Gallery[]
  students     Student[]
  rsvps        Rsvp[]
  comments     Comment[]
  likes        Like[]
  bookmarks    Bookmark[]
  series       Series[]
  // Follow system
  following    Follow[] @relation("Follower")
  followers    Follow[] @relation("Following")
  // Notifications
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsTriggered Notification[] @relation("NotificationActor")
  // Messaging
  sentMessages     Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageRecipient")

  @@map("users")
}

model Student {
  id          String   @id @default(cuid())
  name        String
  nickname    String?  // nama panggilan
  nim         String   @unique
  kelas       String   @default("A") // "A" | "B"
  angkatan    String   @default("2025") // year of admission
  semester    Int      @default(1) // current semester 1-8
  tagline     String?
  bio         String?
  instagram   String?
  asalDaerah  String?  @map("asal_daerah")
  imageUrl    String?  @map("image_url")
  ownerId     String?  @map("owner_id") // user id who can edit this profile
  owner       User?    @relation(fields: [ownerId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Theme song
  lagu        String?  // song title
  laguArtis   String?  @map("lagu_artis") // artist name
  laguUrl     String?  @map("lagu_url") // audio URL (mp3/ogg/etc)

  // Portfolio items (websites, projects, certificates)
  portfolios  StudentPortfolio[]

  @@map("students")
}

// Student Portfolio — supports 3 types:
//   - website: personal/blog/portfolio website
//   - project: program kerja (proker), research project, competition, dll
//   - certificate: professional/academic certifications
model StudentPortfolio {
  id          String   @id @default(cuid())
  studentId   String   @map("student_id")
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type        String   // "website" | "project" | "certificate"
  title       String   // project name, website name, cert title
  description String?  // short description (1-2 sentences)
  url         String?  // website URL, project repo, cert verify URL
  imageUrl    String?  @map("image_url") // thumbnail/logo/screenshot/cert image
  issuer      String?  // for certificates: who issued it (e.g. "Google", "BNSP")
  date        String?  // ISO date string for display (e.g. "2024-08-15")
  order       Int      @default(0) // for sorting within type
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([studentId, type, order])
  @@index([type, studentId])
  @@map("student_portfolios")
}

model Article {
  id          String   @id @default(cuid())
  title       String
  excerpt     String
  content     String?
  category    String   @default("Berita") // Berita | Event | Pengumuman
  date        String   // displayed date string
  author      String
  imageUrl    String?  @map("image_url")
  published   Boolean  @default(true)
  authorId    String   @map("author_id")
  authorUser  User     @relation(fields: [authorId], references: [id])
  comments    Comment[]
  likes       Like[]
  bookmarks   Bookmark[]
  tags        ArticleTag[]
  seriesItems SeriesItem[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("articles")
}

model Series {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?  @map("image_url")
  creatorId   String   @map("creator_id")
  creator     User     @relation(fields: [creatorId], references: [id])
  items       SeriesItem[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("series")
}

model SeriesItem {
  id        String   @id @default(cuid())
  seriesId  String   @map("series_id")
  articleId String   @map("article_id")
  order     Int      @default(0)
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@unique([seriesId, articleId])
  @@map("series_items")
}

model Dosen {
  id          String   @id @default(cuid())
  name        String
  title       String?  // Gelar: "Dr.", "M.Si", etc.
  role        String   @default("Dosen") // "Kaprodi" | "Dosen" | "Lab"
  expertise   String?  // Bidang keahlian
  bio         String?  // Biografi singkat
  email       String?
  imageUrl    String?  @map("image_url")
  courses     String?  // Mata kuliah yang diajar (comma-separated)
  order       Int      @default(0) // for sorting
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("dosen")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#e892b8") // hex color for tag badge
  articles  ArticleTag[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("tags")
}

model ArticleTag {
  articleId String   @map("article_id")
  tagId     String   @map("tag_id")
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([articleId, tagId])
  @@map("article_tags")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  articleId String   @map("article_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, articleId])
  @@map("bookmarks")
}

model Like {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  articleId String   @map("article_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, articleId])
  @@map("likes")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String?
  startDate   String   @map("start_date") // ISO date string for display
  endDate     String?  @map("end_date")
  category    String   @default("Akademik")
  imageUrl    String?  @map("image_url")
  organizerId String   @map("organizer_id")
  organizer   User     @relation(fields: [organizerId], references: [id])
  rsvps       Rsvp[]
  // Recurrence fields
  recurrence  String   @default("none") // "none" | "daily" | "weekly" | "monthly"
  recurrenceEndDate String? @map("recurrence_end_date") // ISO date string when recurrence ends (optional)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("events")
}

model Gallery {
  id          String   @id @default(cuid())
  caption     String
  category    String   @default("Umum")
  imageUrl    String   @map("image_url")
  uploaderId  String   @map("uploader_id")
  uploader    User     @relation(fields: [uploaderId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("gallery")
}

model Rsvp {
  id        String   @id @default(cuid())
  status    String   @default("hadir") // "hadir" | "mungkin" | "tidak"
  userId    String   @map("user_id")
  eventId   String   @map("event_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, eventId])
  @@map("rsvps")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  articleId String   @map("article_id")
  userId    String   @map("user_id")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("comments")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([followerId, followingId])
  @@map("follows")
}

model Notification {
  id          String   @id @default(cuid())
  type        String   // "follow" | "like" | "comment" | "rsvp" | "bookmark"
  recipientId String   @map("recipient_id")
  actorId     String?  @map("actor_id")
  articleId   String?  @map("article_id")
  eventId     String?  @map("event_id")
  content     String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  recipient   User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, read, createdAt])
  @@map("notifications")
}

model Message {
  id          String   @id @default(cuid())
  content     String
  senderId    String   @map("sender_id")
  recipientId String   @map("recipient_id")
  read        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, read, createdAt])
  @@index([senderId, recipientId, createdAt])
  @@map("messages")
}

// Aspirasi Mahasiswa — anonymous (just name) feedback wall
// Used for word cloud visualization
model Aspirasi {
  id          String   @id @default(cuid())
  name        String   // nama pengirim (no login required, just name for tracking)
  content     String   // isi aspirasi
  category    String   @default("Umum") // Akademik | Fasilitas | Organisasi | Sosial | Umum
  approved    Boolean  @default(true) // auto-approve; admin can hide via DELETE
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([approved, createdAt])
  @@index([category, approved])
  @@map("aspirasi")
}
