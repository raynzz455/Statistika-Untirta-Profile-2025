# ============================================================================
# Statistika '25 — Environment Variables Template
# ============================================================================
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# Never commit `.env` to git — it is gitignored by default.
#
# Setup runbook: see SETUP_RUNBOOK.md for complete step-by-step guide.
# Validation: run `bash scripts/setup.sh` to validate + apply all settings.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. DATABASE (Prisma — PostgreSQL via Supabase)
# ----------------------------------------------------------------------------
# Get these from Supabase Dashboard → Project Settings → Database → Connection string
#
# ⚠️ CRITICAL: Use the POOLER URL for DATABASE_URL (port 6543), NOT the direct URL!
#
# DATABASE_URL = "Connection pooling" (Transaction mode, port 6543)
#   → used by app runtime (Supavisor pooler, handles connection scaling)
#   → format: postgresql://postgres.[PROJECT_REF]:[PASS]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# DIRECT_URL = "Direct connection" (Session mode, port 5432)
#   → used ONLY for migrations (db:push, db:migrate)
#   → format: postgresql://postgres.[PROJECT_REF]:[PASS]@db.[PROJECT_REF].supabase.co:5432/postgres
#
# ⚠️ If your password contains special chars (@, #, /, :, etc.), URL-encode them:
#    @ → %40    # → %23    / → %2F    : → %3A
#
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# For local dev (SQLite — no Supabase needed):
# 1. Comment out the postgresql URLs above
# 2. Switch prisma/schema.prisma to sqlite (see comments there)
# 3. Uncomment below:
# DATABASE_URL="file:./db/custom.db"
# DIRECT_URL=""

# ----------------------------------------------------------------------------
# 2. SESSION SECRET (for custom cookie-based auth fallback)
# ----------------------------------------------------------------------------
# Used by src/lib/session.ts for signing session cookies (SHA-256).
# Generate a strong random string (32+ chars):
#   bun -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="REPLACE_WITH_32_PLUS_CHAR_RANDOM_HEX_STRING"

# ----------------------------------------------------------------------------
# 3. SUPABASE API KEYS
# ----------------------------------------------------------------------------
# Get these from Supabase Dashboard → Project Settings → API → Project API keys
#
# ┌────────────────────────────────────────────────────────────────────────┐
# │ IMPORTANT: Supabase Dashboard baru pakai naming yang lebih jelas:     │
# │                                                                        │
# │   "Publishable key" (di Dashboard) = NEXT_PUBLIC_SUPABASE_ANON_KEY    │
# │     ✓ Aman untuk browser — RLS tetap protect data                      │
# │     ✓ Boleh di-expose di client JS                                     │
# │                                                                        │
# │   "Secret key" (di Dashboard) = SUPABASE_SERVICE_ROLE_KEY             │
# │     ✗ SERVER-ONLY — TIDAK boleh di-expose ke browser!                 │
# │     ✗ Bypass RLS — bisa CRUD apapun                                   │
# │     ⚠ Jangan pernah kasih prefix NEXT_PUBLIC_ untuk key ini!          │
# │                                                                        │
# │   Cara ambil Secret key: klik tombol "Reveal" (tersembunyi demi       │
# │   keamanan), lalu copy.                                                │
# └────────────────────────────────────────────────────────────────────────┘
#
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# Publishable key (anon, safe for browser — RLS-protected)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_WITH_YOUR_PUBLISHABLE_KEY"

# Secret key (service_role, SERVER-ONLY — bypasses RLS, NEVER expose to browser)
# ⚠ NEVER prefix this with NEXT_PUBLIC_ or it will leak to client JS!
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_WITH_YOUR_SECRET_KEY"

# ----------------------------------------------------------------------------
# 4. OAUTH PROVIDERS (configured in Supabase Dashboard, not here)
# ----------------------------------------------------------------------------
# Supabase Auth handles OAuth out-of-the-box. Provider credentials are
# configured in Supabase Dashboard → Authentication → Providers.
#
# No env vars needed here — just enable providers in Dashboard:
#   - Google: https://console.cloud.google.com → create OAuth 2.0 client
#   - GitHub: https://github.com/settings/developers → OAuth Apps
#   - Apple: https://developer.apple.com → Sign in with Apple
#
# Redirect URI for all providers (copy to their dashboards):
#   https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
#
# Then on the frontend, call:
#   fetch('/api/auth/oauth/google')  // redirects to Google → back to /auth/callback

# ----------------------------------------------------------------------------
# 5. APP METADATA
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Statistika '25 — Profil Angkatan Untirta"

# ----------------------------------------------------------------------------
# 6. NODE ENV
# ----------------------------------------------------------------------------
NODE_ENV="development"
