# ============================================================================
# Statistika '25 — Environment Variables Template
# ============================================================================
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# Never commit `.env` to git — it is gitignored by default.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. DATABASE (Prisma)
# ----------------------------------------------------------------------------
# Local development (SQLite — default):
DATABASE_URL="file:./db/custom.db"

# Production / Staging (Supabase PostgreSQL):
# 1. Create a project at https://supabase.com
# 2. Project Settings → Database → Connection string
# 3. Copy the URI (pooler URL) and paste below
# 4. Also change `provider = "sqlite"` → `provider = "postgresql"` in prisma/schema.prisma
# 5. Run: bun run db:push && bun run db:seed
#
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].supabase.com:5432/postgres"

# ----------------------------------------------------------------------------
# 2. SESSION SECRET (for custom cookie-based auth, fallback)
# ----------------------------------------------------------------------------
# Used by src/lib/session.ts for signing session cookies (SHA-256).
# Generate a strong random string (32+ chars):
#   bun -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-strong-random-secret-32chars-minimum-xxxxx"

# ----------------------------------------------------------------------------
# 3. SUPABASE (Auth + Storage + Realtime)
# ----------------------------------------------------------------------------
# Get these from Supabase Dashboard → Project Settings → API
# - NEXT_PUBLIC_SUPABASE_URL: Project URL (https://xxxxx.supabase.co)
# - NEXT_PUBLIC_SUPABASE_ANON_KEY: anon public key (safe for browser)
# - SUPABASE_SERVICE_ROLE_KEY: service role key (server-only, NEVER expose)
#
# These are needed if you switch to Supabase Auth (recommended for production).
# The custom session.ts will continue to work for local dev without these.
#
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ----------------------------------------------------------------------------
# 4. OAUTH PROVIDERS (optional, configure per-provider in Supabase Dashboard)
# ----------------------------------------------------------------------------
# Supabase Auth supports OAuth out-of-the-box. You don't need to put provider
# credentials here — instead, configure them in:
#   Supabase Dashboard → Authentication → Providers → [Enable Google/GitHub/etc.]
#
# For Google OAuth:
#   - Google Cloud Console → APIs & Services → Credentials
#   - Create OAuth 2.0 Client ID
#   - Authorized redirect URI:
#     https://[PROJECT_REF].supabase.co/auth/v1/callback
#   - Copy Client ID + Client Secret to Supabase Dashboard
#
# For GitHub OAuth:
#   - GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   - Authorization callback URL:
#     https://[PROJECT_REF].supabase.co/auth/v1/callback
#   - Copy Client ID + Client Secret to Supabase Dashboard
#
# Then on the frontend, call:
#   supabase.auth.signInWithOAuth({ provider: 'google' })
#   supabase.auth.signInWithOAuth({ provider: 'github' })

# ----------------------------------------------------------------------------
# 5. APP METADATA
# ----------------------------------------------------------------------------
# Public-facing site URL (used for OAuth redirects, emails, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Statistika '25 — Profil Angkatan Untirta"

# ----------------------------------------------------------------------------
# 6. NODE ENV
# ----------------------------------------------------------------------------
NODE_ENV="development"
